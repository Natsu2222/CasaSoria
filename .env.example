# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# Postgres connection string. For local dev with docker-compose use:
#   postgresql://payload:payload@localhost:5432/payload
# For production use the URL from your managed Postgres (Supabase / Neon / RDS).
DATABASE_URL=postgresql://payload:payload@localhost:5432/payload

# ─────────────────────────────────────────────────────────────────────────────
# Payload core
# ─────────────────────────────────────────────────────────────────────────────
# Used to encrypt JWT tokens — generate with: openssl rand -base64 48
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash.
# In production: https://your-domain.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs (Vercel Cron / external scheduler).
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Secret used to validate live-preview requests from the admin panel.
PREVIEW_SECRET=YOUR_SECRET_HERE

# ─────────────────────────────────────────────────────────────────────────────
# Media storage — Cloudflare R2 (S3-compatible)
# ─────────────────────────────────────────────────────────────────────────────
# Bucket name in R2.
S3_BUCKET=casa-soria

# R2 doesn't really have regions like AWS — "auto" tells the SDK to figure it out.
S3_REGION=auto

# S3 API endpoint for your R2 account. Format:
#   https://<account-id>.r2.cloudflarestorage.com
# IMPORTANT: do NOT include the bucket name here; the SDK appends it.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Generated in R2 → Manage R2 API Tokens → Create Account API Token
# with "Object Read & Write" scoped to your bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public URL prefix for serving images to visitors. Two options:
#   - Development: https://pub-<id>.r2.dev   (the "Public Development URL"
#                                              shown in your bucket settings)
#   - Production:  https://cdn.your-domain.com   (a Custom Domain linked to the bucket)
# No trailing slash.
S3_PUBLIC_URL=https://pub-<id>.r2.dev

# ─────────────────────────────────────────────────────────────────────────────
# Email (required for admin password reset & user verification flows)
# ─────────────────────────────────────────────────────────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=no-reply@your-domain.com
# EMAIL_FROM_NAME=Casa Soria
